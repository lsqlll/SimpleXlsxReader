{
  "name": "simpletablereader",
  "version": "1.0.0",
  "description": "A lightweight C++ library for reading spreadsheet files (XLS, XLSX, CSV)",
  "scripts": {
    "prepare": "husky install",
    "format": "clang-format -i \"src/**/*.{hpp,cpp}\" \"test/**/*.{cpp}\"",
    "check": "clang-format --dry-run -Werror \"src/**/*.{hpp,cpp}\" \"test/**/*.{cpp}\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "packageManager": "pnpm@10.28.0"
}
