{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Debug (MSYS2 MingW64 Bash)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "E:/msys64/mingw64/bin;${env:PATH}"
                }
            ],
            "externalConsole": true, // 使用VSCode内置终端
            "windows": {
                "MIMode": "gdb",
                "miDebuggerPath": "E:/msys64/mingw64/bin/gdb.exe",
                "setupCommands": [
                    {
                        "description": "启用整齐打印",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ]
            }
        }
    ]
}