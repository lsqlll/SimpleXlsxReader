package "Strategy Pattern" {
    interface IReaderStrategy <<strategy>> {
        + {abstract} ~IReaderStrategy()
        + {abstract} openWorkbook(path: filesystem::path): unique_ptr<IWorkbook>
        + {abstract} canHandle(path: filesystem::path): bool
        + {abstract} getFormatName(): string
    }
    
    class XlsReaderStrategy <<strategy>> {
        + openWorkbook(path: filesystem::path): unique_ptr<IWorkbook>
        + canHandle(path: filesystem::path): bool
        + getFormatName(): string
    }
    
    class XlsxReaderStrategy <<strategy>> {
        + openWorkbook(path: filesystem::path): unique_ptr<IWorkbook>
        + canHandle(path: filesystem::path): bool
        + getFormatName(): string
    }
    
    class CsvReaderStrategy <<strategy>> {
        + openWorkbook(path: filesystem::path): unique_ptr<IWorkbook>
        + canHandle(path: filesystem::path): bool
        + getFormatName(): string
    }
    
    IReaderStrategy <|.. XlsReaderStrategy
    IReaderStrategy <|.. XlsxReaderStrategy
    IReaderStrategy <|.. CsvReaderStrategy
    
    IReaderStrategy ..> IWorkbook : creates
    XlsReaderStrategy ..> XlsWorkbook : creates
    XlsxReaderStrategy ..> XlsxWorkbook : creates
}

package "Factory Pattern" {
    class ReaderStrategyFactory <<factory>> {
        - {static} instance_: ReaderStrategyFactory
        - strategies_: vector<unique_ptr<IReaderStrategy>>
        - ReaderStrategyFactory()
        + {static} getInstance(): ReaderStrategyFactory&
        + createStrategy(path: filesystem::path): unique_ptr<IReaderStrategy>
        + registerStrategy(strategy: unique_ptr<IReaderStrategy>): void
        + getSupportedFormats(): vector<string>
    }
    
    class WorkbookFactory <<factory>> {
        + {static} open(path: filesystem::path): unique_ptr<IWorkbook>
        + {static} openWithStrategy(path: filesystem::path, strategy: unique_ptr<IReaderStrategy>): unique_ptr<IWorkbook>
    }
    
    ReaderStrategyFactory o-- IReaderStrategy : manages
    WorkbookFactory ..> ReaderStrategyFactory : uses
    WorkbookFactory ..> IReaderStrategy : uses
    WorkbookFactory ..> IWorkbook : creates
}

package "Supporting Types" {
    enum CellType {
        STRING
        NUMBER
        BOOL
        UNKNOWN
        BLANK
        DATE
    }
    
    class CellPosition {
        + row: optional<size_t>
        + col: optional<size_t>
        + addr: optional<string>
        + CellPosition(nullopt_t)
        + CellPosition(row: size_t, col: size_t)
        + CellPosition(addr: string)
        + getRow(): size_t
        + getCol(): size_t
        + getAddr(): string
    }
    
    ICell ..> CellType : uses
    ICell ..> CellPosition : uses
}

note top of ICell
  Interface defining unified cell access.
  All format-specific cells must implement this.
end note

note top of IWorksheet
  Interface defining unified worksheet access.
  Supports lazy loading of content.
end note

note top of IWorkbook
  Interface representing the entire workbook.
  Factory pattern creates concrete implementations.
end note

note top of IReaderStrategy
  Strategy pattern interface for format-specific readers.
  Each format implements its own strategy.
end note

note top of ReaderStrategyFactory
  Singleton factory that manages all reader strategies.
  Selects appropriate strategy based on file extension.
end note

note top of WorkbookFactory
  Main entry point for users.
  Usage: WorkbookFactory::open("file.xls")
end note

@enduml
